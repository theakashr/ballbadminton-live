# ==============================================================================
# Ball Badminton Live — Supabase Environment Configuration
# ==============================================================================
# Copy this file to .env.local or .env for local development:
# cp .env.example .env.local

# 1. Supabase Project REST URL
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Publishable Key
# Found in Supabase Dashboard -> Project Settings -> API -> anon public key
# Safe to expose in client browsers; protected by PostgreSQL Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Development Mode Toggle (Optional: 'auto' | 'demo' | 'supabase')
# 'auto' connects to Supabase if keys are provided, otherwise falls back to local prototype.
VITE_DATA_LAYER_MODE=auto

# IMPORTANT SECURITY WARNING:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or database connection strings in Vite frontend!
